<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Compressing a long document takes minutes, and Android freezes a
        backgrounded app within seconds unless something holds it open. These
        keep that work running and tell the user when it has finished. They are
        the only permissions the app asks for.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        allowBackup is left on deliberately, and it is worth being precise about
        what that means for an app that promises files never leave the phone.
        Android's backup never includes the cache directory, which is where a
        prepared photo, signature or PDF is written before it is shared, so no
        user file is in scope. What is in scope is the settings store: the
        onboarding flag and any exam presets the user typed in. Those are the
        user's own settings, and carrying them to a new phone is the behaviour
        people expect. The privacy policy says so rather than leaving it implied.
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <service
            android:name=".BackgroundWorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

    <!--
        FormReady processes everything on-device: INTERNET is deliberately not
        requested, so the app cannot send a file anywhere even if it tried.
    -->

</manifest>
